{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noImplicitAny": false,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@pfos/shared": ["./packages/shared/src/index.ts"],
      "@pfos/shared/*": ["./packages/shared/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "server", "packages/shared/src", "server.ts"]
}
