# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL. Matches docker-compose.yml out of the box.
DATABASE_URL="postgresql://pfos:pfos@localhost:5432/pfos?schema=public"

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use DIFFERENT values for the two. Minimum 32 characters; the server refuses
# to boot otherwise.
JWT_ACCESS_SECRET="change-me-to-a-64-character-hex-string-before-running-anything"
JWT_REFRESH_SECRET="change-me-to-a-different-64-character-hex-string-entirely-ok"

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list for multiple origins.
CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

LOG_LEVEL=info

# Optional: Google sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Frontend (web/.env)
VITE_API_URL=http://localhost:4000/api
